# MongoDB connection
# Connect to your local MongoDB instance or MongoDB Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/buzquitos

# Admin authentication credentials for /admin/login
ADMIN_EMAIL=admin@buzquitos.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Optional: comma-separated admin emails used as an extra allow-list
ADMIN_EMAILS=admin@buzquitos.com

# Public collection configuration
NEXT_PUBLIC_COLLECTION_NAME=Buzquitos
NEXT_PUBLIC_COLLECTION_TAGLINE=Small pixels. Big personalities.
NEXT_PUBLIC_NETWORK=Ethereum
NEXT_PUBLIC_SUPPLY=5555
NEXT_PUBLIC_MINT_PRICE=TBA
NEXT_PUBLIC_MINT_DATE=To be announced
NEXT_PUBLIC_X_URL=https://x.com/Buzquitos
